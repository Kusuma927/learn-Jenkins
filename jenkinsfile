pipeline {
    agent {
       label 'AGENT-1'
    }
    stages {
        stage('Build') {
            steps {
                echo "This is Build"
            }
        }
        stage('Test') {
            steps {
                 echo "This is Test"
            }
        }
        stage('Deploy') {
            steps {
                 echo "This is Deploy"
                 //error "pipeline failed"
            }
        }
    }
    
    post{
        always{
            echo "This section runs always"
            deleteDir()
        }
        success{
            echo "This section runs when pipeline is successful"
        }
        failure{
            echo "This section runs when pipeline is failed"
        }
    }
    
}